# autodoc --server as a systemd service: docs/enterprise/operations.md.
#
#   useradd --system --no-create-home --shell /usr/sbin/nologin autodoc
#   install -m 0755 autodoc /usr/local/bin/autodoc
#   install -d -m 0750 -g autodoc /etc/autodoc && install -m 0640 -g autodoc server.toml /etc/autodoc/   (+ views/, TLS files)
#   install -m 0600 server.env /etc/autodoc/server.env      # read by systemd, as root: AUTODOC_SERVER_DSN=…, WEB_APP_TOKEN=…
#   cp autodoc-server.service /etc/systemd/system/ && systemctl enable --now autodoc-server

[Unit]
Description=AutoDoc enterprise search server
Documentation=https://github.com/yongjohnlee80/autodoc/blob/main/docs/enterprise/operations.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/autodoc --server /etc/autodoc/server.toml
EnvironmentFile=/etc/autodoc/server.env

# Exit 2 is a configuration the server refuses: restarting cannot mend it. Exit 1 (the database
# lost, a tenant's writer lock lost) is restarted.
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=5s

# SIGTERM stops it in order: the API drains its requests (35s at most), then the rest unwinds and
# the writer locks are released. The stop timeout outlasts both.
KillSignal=SIGTERM
TimeoutStopSec=60

# A system user of its own, which reads /etc/autodoc through its group: the files are root's, 0640,
# group autodoc. (A dynamic user is in no group the files could name, so it couldn't read them.)
User=autodoc
Group=autodoc
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/etc/autodoc

[Install]
WantedBy=multi-user.target
