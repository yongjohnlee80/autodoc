flowchart LR
    SRC["Source File (.go, .ts, .tsx, .js, .py, .rs, + custom)"] --> ROUTER["Extension Router (core/registrations)"]
    ROUTER --> GOAST["Go AST Chunker (go/parser, code-go-2+text-5)"]
    ROUTER --> SCAN["Scanner Chunkers (TypeScript code-ts-2, Python code-py-2, Rust code-rs-2)"]
    ROUTER --> CUSTOM["Custom Chunkers & text_extensions (app.Options.Chunkers / chunk.Text)"]
    GOAST --> SPLIT["Two-Surface Unit (Body = Verbatim Code, Embed = Breadcrumb + Doc + Signature)"]
    SCAN --> SPLIT
    CUSTOM --> SPLIT
    SPLIT --> STORE["SQLite chunks & FTS5 & Vector Tables"]
    STORE --> QUERY["search.query (Lexical + Semantic + Reranked Code Retrieval)"]
