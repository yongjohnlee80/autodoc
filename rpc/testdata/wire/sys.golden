  {errors: [{code: int(-32060), messages: ["no such workspace"], name: "rpc.no_such_workspace", next: <str>}, {code: int(-32602), messages: ["embedding policy must be always, when opened, or never", "a preference needs a name", "this preference is set by its own verb: embedding.use, ranker.use or ranker.window", "no model switch is under way", "a ranker needs a name, a kind (tei or rerank-api), a base URL, and a model for rerank-api", "this build supplies its ranker", "a ranker's window is 10 to 100 candidates", "a provider needs a name, a kind (ollama, ollama-cloud or openai), a base URL and a model", "a provider's context window is 256 to 262144 tokens", "an Ollama Cloud provider needs its API key", "the root is not a directory", "not a valid workspace: a name without a path separator, an absolute root, and valid patterns", "a derived document is read-only: its text is served, its file never written", "not a file of this workspace", "the document is over the size limit", "not a valid path in the workspace", "unknown search mode", "search stages must include lexical or semantic: a ranker only re-orders what they find", "unknown search stage: the stages are lexical, semantic and rerank", "a search stage is named twice", "search stages and a search mode together: send one or the other", "a facet filter names a field the workspace's schema does not declare", "a facet filter's value is not of its field's type", "the model is in use"], name: "rpc.invalid_params", next: <str>}], min_protocol: int(12), protocol: int(22), verbs: [{audience: "agent", doc: "Where one link reaches now, saved or not, as the index resolves links: path \"\" with reason missing or ambiguous, or \"\" when raw is no link the index keeps (a URL, a heading of from).", effect: "read", errors: [int(-32060)], params: [{name: "workspace", type: "string"}, {doc: "the file the link is written in", name: "from", type: "string"}, {doc: "the link as written", name: "raw", type: "string"}], result: "{path, reason}", scope: "workspace", since: int(18), verb: "graph.resolve"}]}
