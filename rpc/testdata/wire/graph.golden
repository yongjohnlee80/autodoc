graph.neighborhood ["kb", "plan.md", int(1)]
  {edges: [{dst: "target.md", kind: "wikilink", src: "plan.md"}, {dst: "plan.md", kind: "wikilink", src: "target.md"}], nodes: ["plan.md", "target.md"]}
